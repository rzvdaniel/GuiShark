<Project>
  <PropertyGroup>
    <GuiSharkMsdfGenerator Condition="'$(GuiSharkMsdfGenerator)' == ''">$(GUISHARK_MSDF_GENERATOR)</GuiSharkMsdfGenerator>
    <GuiSharkGenerateMsdfAtlases Condition="'$(GuiSharkGenerateMsdfAtlases)' == '' and '$(GuiSharkMsdfGenerator)' != ''">true</GuiSharkGenerateMsdfAtlases>
    <GuiSharkGenerateMsdfAtlases Condition="'$(GuiSharkGenerateMsdfAtlases)' == ''">false</GuiSharkGenerateMsdfAtlases>
    <GuiSharkMsdfAssetPath Condition="'$(GuiSharkMsdfAssetPath)' == ''">Assets/atlas</GuiSharkMsdfAssetPath>
    <GuiSharkMsdfCharset Condition="'$(GuiSharkMsdfCharset)' == ''">[0x20,0x17f], [0x2010,0x2026]</GuiSharkMsdfCharset>
    <GuiSharkMsdfEmSize Condition="'$(GuiSharkMsdfEmSize)' == ''">48</GuiSharkMsdfEmSize>
    <GuiSharkMsdfDistanceRange Condition="'$(GuiSharkMsdfDistanceRange)' == ''">4</GuiSharkMsdfDistanceRange>
    <_GuiSharkMsdfBuildFile>$(MSBuildThisFileFullPath)</_GuiSharkMsdfBuildFile>
    <_GuiSharkMsdfTaskSource>$(MSBuildThisFileDirectory)GenerateMsdfAtlas.cs</_GuiSharkMsdfTaskSource>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <GuiSharkMsdfFont>
      <AtlasName>%(Filename)</AtlasName>
      <Charset>$(GuiSharkMsdfCharset)</Charset>
      <EmSize>$(GuiSharkMsdfEmSize)</EmSize>
      <DistanceRange>$(GuiSharkMsdfDistanceRange)</DistanceRange>
    </GuiSharkMsdfFont>
  </ItemDefinitionGroup>

  <UsingTask TaskName="GenerateMsdfAtlas" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Language="cs" Source="$(_GuiSharkMsdfTaskSource)" /></Task>
  </UsingTask>

  <Target Name="GuiSharkPrepareMsdfAtlases"
          Condition="'$(GuiSharkGenerateMsdfAtlases)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(_GuiSharkMsdfCleaning)' != 'true'">
    <Error Condition="'$(GuiSharkMsdfGenerator)' == ''"
           Text="MSDF generation requires GuiSharkMsdfGenerator (or GUISHARK_MSDF_GENERATOR), pointing to a native msdf-atlas-gen executable for the build host." />
    <Error Condition="!Exists('$(GuiSharkMsdfGenerator)')" Text="MSDF generator not found: $(GuiSharkMsdfGenerator)" />
    <Error Condition="'@(GuiSharkMsdfFont)' == ''" Text="MSDF generation requires at least one GuiSharkMsdfFont item." />
    <Error Condition="!Exists('%(GuiSharkMsdfFont.FullPath)')" Text="MSDF font not found: %(GuiSharkMsdfFont.FullPath)" />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(GuiSharkMsdfFont.AtlasName)', '^[A-Za-z0-9][A-Za-z0-9_.-]*$'))"
           Text="MSDF AtlasName must be a simple unique file name: %(GuiSharkMsdfFont.AtlasName)" />
    <ItemGroup><_GuiSharkAtlasNames Include="@(GuiSharkMsdfFont->'%(AtlasName)')" /></ItemGroup>
    <RemoveDuplicates Inputs="@(_GuiSharkAtlasNames)"><Output TaskParameter="Filtered" ItemName="_GuiSharkUniqueAtlasNames" /></RemoveDuplicates>
    <Error Condition="'@(_GuiSharkAtlasNames->Count())' != '@(_GuiSharkUniqueAtlasNames->Count())'"
           Text="MSDF AtlasName values must be unique; use explicit names for fonts with the same file name." />
    <PropertyGroup><_GuiSharkMsdfOutputDirectory>$(IntermediateOutputPath)guishark-msdf/</_GuiSharkMsdfOutputDirectory></PropertyGroup>
    <MakeDir Directories="$(_GuiSharkMsdfOutputDirectory)" />
    <ConvertToAbsolutePath Paths="$(GuiSharkMsdfGenerator)"><Output TaskParameter="AbsolutePaths" PropertyName="_GuiSharkMsdfGeneratorPath" /></ConvertToAbsolutePath>
    <ItemGroup>
      <_GuiSharkAtlas Include="@(GuiSharkMsdfFont)">
        <ImageOutput>$(_GuiSharkMsdfOutputDirectory)%(GuiSharkMsdfFont.AtlasName).png</ImageOutput>
        <MetadataOutput>$(_GuiSharkMsdfOutputDirectory)%(GuiSharkMsdfFont.AtlasName).json</MetadataOutput>
        <SettingsFile>$(_GuiSharkMsdfOutputDirectory)%(GuiSharkMsdfFont.AtlasName).settings</SettingsFile>
        <CompletionStamp>$(_GuiSharkMsdfOutputDirectory)%(GuiSharkMsdfFont.AtlasName).complete</CompletionStamp>
      </_GuiSharkAtlas>
    </ItemGroup>
    <WriteLinesToFile File="%(_GuiSharkAtlas.SettingsFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="Font=%(_GuiSharkAtlas.FullPath);Generator=$(_GuiSharkMsdfGeneratorPath);Charset=%(_GuiSharkAtlas.Charset);EmSize=%(_GuiSharkAtlas.EmSize);DistanceRange=%(_GuiSharkAtlas.DistanceRange)" />
  </Target>

  <!-- Batch by font: unchanged fonts do not rerun the native generator. -->
  <Target Name="GuiSharkGenerateMsdfFont" DependsOnTargets="GuiSharkPrepareMsdfAtlases"
          Condition="'$(GuiSharkGenerateMsdfAtlases)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(_GuiSharkMsdfCleaning)' != 'true'"
          Inputs="%(_GuiSharkAtlas.FullPath);%(_GuiSharkAtlas.SettingsFile);$(_GuiSharkMsdfGeneratorPath);$(_GuiSharkMsdfBuildFile);$(_GuiSharkMsdfTaskSource)"
          Outputs="%(_GuiSharkAtlas.ImageOutput);%(_GuiSharkAtlas.MetadataOutput);%(_GuiSharkAtlas.CompletionStamp)">
    <GenerateMsdfAtlas Generator="$(_GuiSharkMsdfGeneratorPath)" Font="%(_GuiSharkAtlas.FullPath)"
                       ImageOutput="%(_GuiSharkAtlas.ImageOutput)" MetadataOutput="%(_GuiSharkAtlas.MetadataOutput)"
                       CompletionStamp="%(_GuiSharkAtlas.CompletionStamp)" Charset="%(_GuiSharkAtlas.Charset)"
                       EmSize="%(_GuiSharkAtlas.EmSize)" DistanceRange="%(_GuiSharkAtlas.DistanceRange)" />
  </Target>

  <Target Name="GuiSharkIncludeMsdfAtlases" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GuiSharkGenerateMsdfFont"
          Condition="'$(GuiSharkGenerateMsdfAtlases)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(_GuiSharkMsdfCleaning)' != 'true'">
    <ItemGroup>
      <Content Remove="@(_GuiSharkAtlas->'$(GuiSharkMsdfAssetPath)/%(AtlasName).png');@(_GuiSharkAtlas->'$(GuiSharkMsdfAssetPath)/%(AtlasName).json')" />
      <Content Include="%(_GuiSharkAtlas.ImageOutput)" Link="$(GuiSharkMsdfAssetPath)/%(_GuiSharkAtlas.AtlasName).png"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="%(_GuiSharkAtlas.MetadataOutput)" Link="$(GuiSharkMsdfAssetPath)/%(_GuiSharkAtlas.AtlasName).json"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(_GuiSharkAtlas->'%(ImageOutput)');@(_GuiSharkAtlas->'%(MetadataOutput)');@(_GuiSharkAtlas->'%(SettingsFile)');@(_GuiSharkAtlas->'%(CompletionStamp)')" />
    </ItemGroup>
  </Target>

  <!-- Switching generation off must restore bundled assets, even if generated copies are newer. -->
  <Target Name="GuiSharkUseBundledMsdfAtlases" BeforeTargets="AssignTargetPaths"
          Condition="'$(GuiSharkGenerateMsdfAtlases)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Update="@(GuiSharkMsdfFont->'$(GuiSharkMsdfAssetPath)/%(AtlasName).png');@(GuiSharkMsdfFont->'$(GuiSharkMsdfAssetPath)/%(AtlasName).json')"
               CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>

  <Target Name="GuiSharkMsdfBeginClean" BeforeTargets="BeforeClean">
    <PropertyGroup><_GuiSharkMsdfCleaning>true</_GuiSharkMsdfCleaning></PropertyGroup>
  </Target>
  <Target Name="GuiSharkMsdfBeginBuild" BeforeTargets="BeforeBuild">
    <PropertyGroup><_GuiSharkMsdfCleaning>false</_GuiSharkMsdfCleaning></PropertyGroup>
  </Target>
</Project>
