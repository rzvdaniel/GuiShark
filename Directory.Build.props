<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep reviewed analyzer warnings visible; no enforced error IDs belong in this list. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1501;S1118;S1121;S1244;S127;S1481;S2245;S2681;S3265;S3267;S3358;S4136;S6618;S6640;S8969;S927</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
